                  }
                ]
              },
              "groupBy": [
                {
                  "key": "collector",
                  "dataType": "string",
                  "type": "tag",
                  "isColumn": false
                }
              ],
              "expression": "A",
              "disabled": false,
              "having": [],
              "stepInterval": 60,
              "reduceTo": "avg",
              "functions": [],
              "legend": ""
