    {
      "alert": "NeoForge ledger dropping events",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "threshold_rule",
      "version": "v4",
      "condition": {
        "compositeQuery": {
          "queryType": "builder",
          "panelType": "graph",
          "unit": "",
          "builderQueries": {
            "A": {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "rate",
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "aggregateAttribute": {
                "key": "geldar_ledger_dropped_total",
                "dataType": "float64",
                "type": "Sum",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "key": {
                      "key": "service.name",
                      "dataType": "string",
                      "type": "resource",
                      "isColumn": false,
                      "isJSON": false
                    },
                    "op": "=",
                    "value": "geldar-neoforge"
                  }
                ]
              },
              "groupBy": [
                {
                  "key": "queue",
                  "dataType": "string",
                  "type": "tag",
                  "isColumn": false
                }
              ],
              "expression": "A",
              "disabled": false,
              "having": [],
              "stepInterval": 60,
              "reduceTo": "avg",
              "functions": [],
              "legend": ""
            }
          }
        },
        "op": "1",
        "target": 0,
        "matchType": "2",
        "selectedQueryName": "A",
        "alertOnAbsent": false
      },
      "evalWindow": "10m0s",
      "frequency": "1m",
      "labels": { "severity": "warning" },
      "annotations": {
        "description": "The Ledger dropped events on a queue for 10 minutes: the sink or the exporter is slower than the producers, check the queue depth.",
        "summary": "NeoForge ledger dropping events"
      },
      "preferredChannels": ["geldar-owner-channel"],
      "disabled": false
    },
    {
      "alert": "NeoForge collector disabled",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "threshold_rule",
      "version": "v4",
      "condition": {
        "compositeQuery": {
          "queryType": "builder",
          "panelType": "graph",
          "unit": "",
          "builderQueries": {
            "A": {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": {
                "key": "geldar_paper_collector_disabled",
                "dataType": "float64",
                "type": "Gauge",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "key": {
                      "key": "service.name",
                      "dataType": "string",
                      "type": "resource",
                      "isColumn": false,
                      "isJSON": false
                    },
                    "op": "=",
