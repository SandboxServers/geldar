{
  "rules": [
    {
      "alert": "NeoForge container CPU throttled",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "threshold_rule",
      "version": "v4",
      "condition": {
        "compositeQuery": {
          "queryType": "builder",
          "panelType": "graph",
          "unit": "",
          "builderQueries": {
            "A": {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": {
                "key": "geldar_container_cpu_throttled_periods_total",
                "dataType": "float64",
                "type": "Gauge",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "key": {
                      "key": "service.name",
                      "dataType": "string",
                      "type": "resource",
                      "isColumn": false,
                      "isJSON": false
                    },
                    "op": "=",
                    "value": "geldar-neoforge"
                  }
                ]
              },
              "groupBy": [],
              "expression": "A",
              "disabled": true,
              "having": [],
              "stepInterval": 60,
              "reduceTo": "avg",
              "functions": [],
              "legend": ""
            },
            "B": {
              "queryName": "B",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": {
                "key": "geldar_container_cpu_periods_total",
                "dataType": "float64",
                "type": "Gauge",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "key": {
                      "key": "service.name",
                      "dataType": "string",
                      "type": "resource",
                      "isColumn": false,
                      "isJSON": false
                    },
                    "op": "=",
                    "value": "geldar-neoforge"
                  }
                ]
              },
              "groupBy": [],
              "expression": "B",
              "disabled": true,
              "having": [],
              "stepInterval": 60,
              "reduceTo": "avg",
              "functions": [],
              "legend": ""
            },
            "F1": {
              "queryName": "F1",
              "expression": "A / B",
              "disabled": false,
              "legend": ""
            }
          }
        },
        "op": "1",
        "target": 0.05,
        "matchType": "3",
        "selectedQueryName": "F1",
        "alertOnAbsent": false
      },
      "evalWindow": "10m0s",
      "frequency": "1m",
      "labels": { "severity": "warning" },
      "annotations": {
        "description": "More than 5 percent of CPU periods were throttled (PROPOSED threshold): raise the container CPU limit or reduce load.",
        "summary": "NeoForge container CPU throttled"
      },
      "preferredChannels": ["geldar-owner-channel"],
      "disabled": false
    },
