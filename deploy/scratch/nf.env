# Published ports for the scratch project scratch-nf (the NeoForge variant): each is the scratch-a default of
# compose/opt-in/scratch.yml plus 20000, so it runs beside scratch-a, scratch-telemetry and the live stacks.
# Use with SCRATCH_PLATFORM=neoforge (see docs/runbooks/scratch-stack.md). Loopback only.
# Read by deploy/scratch/scratch.sh; do not source it. A SCRATCH_*_PORT variable already set in the operator's
# environment wins over this file.
# Only the SCRATCH_*_PORT keys, digits 1 to 65535, no secrets.
SCRATCH_PG_PORT=35432
SCRATCH_NATS_PORT=34222
SCRATCH_NATS_MON_PORT=38222
SCRATCH_MC_PORT=55565
# RCON for the NeoForge game server only (compose/opt-in/scratch-neoforge.yml). Its password is the run's own rcon.txt.
SCRATCH_RCON_PORT=55575
