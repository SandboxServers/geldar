# Published ports for the scratch project scratch-telemetry: each is the scratch-a default of
# compose/opt-in/scratch.yml plus 10000, so the two projects can run side by side.
# Sourced by the operator before "sh deploy/scratch/scratch.sh up telemetry"; the script never reads this file.
# Plain KEY=value lines, loopback ports only, no secrets.
SCRATCH_PG_PORT=25432
SCRATCH_NATS_PORT=24222
SCRATCH_NATS_MON_PORT=28222
SCRATCH_MC_PORT=45565
