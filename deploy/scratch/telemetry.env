# Published ports for the scratch project scratch-telemetry: each is the scratch-a default of
# compose/opt-in/scratch.yml plus 10000, so the two projects can run side by side.
# Read by deploy/scratch/scratch.sh for the project telemetry (required there); do not source it. A SCRATCH_*_PORT
# variable already set in the operator's environment wins over this file.
# Only the five SCRATCH_*_PORT keys, digits 1 to 65535, loopback ports only, no secrets.
SCRATCH_PG_PORT=25432
SCRATCH_NATS_PORT=24222
SCRATCH_NATS_MON_PORT=28222
SCRATCH_MC_PORT=45565
SCRATCH_RCON_PORT=45575
