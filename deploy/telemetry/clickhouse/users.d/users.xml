<?xml version="1.0"?>
<!--
  Authored for Geldar (0352 and 0370). [AUTH] Not upstream.
  Password hashes are NOT in git. Each hash is read from the container environment with from_env:
  GELDAR_CH_WRITER_SHA256 and GELDAR_CH_READER_SHA256. Compose loads them from the node-only env file
  /mnt/nvme/geldar-telemetry/secrets/ch-hashes.env (README, "Password hashes"). from_env in config is [INF, unverified on 25.12.5].
  Limits from 0352: writer max_memory_usage 2 GB, max_threads 4, max_execution_time 60, max_insert_threads 2.
  Reader limits follow 0352 (Read path, B): readonly 2, 1 GB, max_execution_time 30, max_result_rows 100000 with break,
  SELECT grants on the signoz_* databases. Threads 4 are [AUTH]. The per-hour read quota of 0352 is NOT set here: 0352 gives no value [UNV].
  The grants use the XML users grants element [INF, unverified on 25.12.5]. geldar_writer is granted the six signoz_* databases the
  migrator creates (signoz_analytics, signoz_logs, signoz_metadata, signoz_meter, signoz_metrics, signoz_traces). geldar_reader is
  granted SELECT on signoz_traces, signoz_logs, signoz_metrics and signoz_metadata only; it has NO grant on signoz_meter or
  signoz_analytics (left as is; a gap to decide, not changed here).
  default: kept because the cluster entry in cluster.xml has no user, so ON CLUSTER DDL runs as default (README item 9).
  Networks for default are loopback only (127.0.0.1, ::1). Both <networks> and each <ip> carry replace="replace" so the stock ::/0
  is not kept by the merge [INF, unverified on 25.12.5; README item 21]. default has no access_management (N2).
  Nothing is published. Widen only if the scratch run shows ON CLUSTER refused.
-->
<clickhouse>
    <profiles>
        <geldar_writer>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_threads>4</max_threads>
            <max_execution_time>60</max_execution_time>
            <max_insert_threads>2</max_insert_threads>
            <load_balancing>in_order</load_balancing>
            <log_queries>1</log_queries>
        </geldar_writer>
        <geldar_reader>
            <readonly>2</readonly>
            <max_memory_usage>1000000000</max_memory_usage>
            <max_threads>4</max_threads>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
            <load_balancing>in_order</load_balancing>
        </geldar_reader>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks replace="replace">
                <ip replace="replace">127.0.0.1</ip>
                <ip replace="replace">::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
        <geldar_writer>
            <password_sha256_hex from_env="GELDAR_CH_WRITER_SHA256"/>
            <profile>geldar_writer</profile>
            <quota>default</quota>
            <!-- authored; the scratch run showed the migrator ran with full privileges, so this list is a hypothesis to be verified in
                 scratch round 5; if the migrator fails on a missing privilege the error names it. Not granted on purpose: SYSTEM, FILE,
                 URL, S3, MYSQL, POSTGRES, SOURCES, KILL QUERY, dictGet, INTROSPECTION. CREATE DATABASE is not granted on *.*;
                 the CREATE grants above are on the six signoz_* databases only. CREATE on a database covers CREATE TABLE, CREATE VIEW
                 (materialized views) and CREATE DICTIONARY, so no separate VIEW grant is listed. ALTER covers ALTER UPDATE (the migration
                 status mutation). Table engines are granted one query each, because the Distributed engine's source is REMOTE.
                 REMOTE gives the writer the remote() and cluster() table functions to any host. This residual risk is accepted: the
                 writer's password is held only by the migrator and the collector, and the container network is private. The hypothesis
                 that the Distributed engine grant needs REMOTE is [UNV] until scratch round 5 confirms it (a failure names the missing
                 privilege). [AUTH] -->
            <grants>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_traces.*</query>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_logs.*</query>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_metrics.*</query>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_metadata.*</query>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_meter.*</query>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, OPTIMIZE, SHOW ON signoz_analytics.*</query>
                <query>GRANT SELECT ON system.*</query>
                <query>GRANT CLUSTER ON *.*</query>
                <query>GRANT TABLE ENGINE ON Distributed</query>
                <query>GRANT TABLE ENGINE ON ReplicatedMergeTree</query>
                <query>GRANT TABLE ENGINE ON ReplicatedReplacingMergeTree</query>
                <query>GRANT TABLE ENGINE ON ReplicatedAggregatingMergeTree</query>
                <query>GRANT TABLE ENGINE ON ReplicatedSummingMergeTree</query>
                <query>GRANT TABLE ENGINE ON MergeTree</query>
                <query>GRANT TABLE ENGINE ON ReplacingMergeTree</query>
                <query>GRANT TABLE ENGINE ON AggregatingMergeTree</query>
                <query>GRANT TABLE ENGINE ON SummingMergeTree</query>
                <query>GRANT REMOTE ON *.*</query>
                <query>GRANT SHOW ON *.*</query>
            </grants>
            <networks>
                <ip>::/0</ip>
            </networks>
        </geldar_writer>
        <geldar_reader>
            <password_sha256_hex from_env="GELDAR_CH_READER_SHA256"/>
            <profile>geldar_reader</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON signoz_traces.*</query>
                <query>GRANT SELECT ON signoz_logs.*</query>
                <query>GRANT SELECT ON signoz_metrics.*</query>
                <query>GRANT SELECT ON signoz_metadata.*</query>
            </grants>
            <networks>
                <ip>::/0</ip>
            </networks>
        </geldar_reader>
    </users>
</clickhouse>
