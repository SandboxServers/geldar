<?xml version="1.0"?>
<!--
  System log TTL, 30 days, as the Geldar 0352 retention for system tables. [AUTH]
  Key names and the TTL expression come from Foundry config-0-0.yaml [SRC]. The facts file gives a one-day TTL there; this file
  sets 30 days (INTERVAL 30 DAY) because the packet asks for 30 days.
  Coverage: the file covers the system *_log tables observed on ClickHouse 25.12.5 (build 44) in the local scratch run.
  That run found 11 such tables, all with a TTL after this file was loaded (report 5, round 4). The file has 23 sections.
  opentelemetry_span_log has its TTL inside its engine, because the stock config sets an engine for that table.
  The scratch run started the server with this file (report 6). A new ClickHouse version may add or rename log tables,
  so check the system.tables list of *_log tables after each upgrade (README item 25).
-->
<clickhouse>
    <!-- Other tables in this list are assumed to use event_date; scratch round 3 verifies each by startup. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </part_log>
    <trace_log>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </trace_log>
    <text_log>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </text_log>
    <metric_log>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </metric_log>
    <processors_profile_log>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </processors_profile_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <error_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </error_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_metric_log>
    <query_thread_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_thread_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_views_log>
    <session_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </session_log>
    <zookeeper_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </zookeeper_log>
    <!-- [AUTH] The 10 live *_log tables that had no section (scratch run, report2 step 6). Same form as the sections above. -->
    <aggregated_zookeeper_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </aggregated_zookeeper_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </asynchronous_insert_log>
    <backup_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </backup_log>
    <blob_storage_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </blob_storage_log>
    <crash_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </crash_log>
    <delta_lake_metadata_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </delta_lake_metadata_log>
    <iceberg_metadata_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </iceberg_metadata_log>
    <!-- [AUTH] stock config sets an engine for this table, so TTL goes inside the engine; column is finish_date (no event_date);
         verified against the image's /etc/clickhouse-server/config.xml lines 1366-1389. -->
    <opentelemetry_span_log>
        <engine replace="replace">engine MergeTree partition by toYYYYMM(finish_date) order by (finish_date, finish_time_us) TTL finish_date + INTERVAL 30 DAY DELETE</engine>
    </opentelemetry_span_log>
    <s3queue_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </s3queue_log>
    <zookeeper_connection_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </zookeeper_connection_log>
</clickhouse>
