# The secret files deploy/gen-secrets.sh creates in GELDAR_SECRETS_DIR, one bare file name per line. No values here.
# This is the default list; GELDAR_SECRETS_LIST names another list for an environment. A name is created only when its
# file is missing. The NATS server config and the other NATS per-role passwords are not in this list (decision 0080).
postgres.txt
rcon.txt
velocity-forwarding.txt
nats-body.txt
postgres-mcp.txt
postgres-glass.txt
postgres-register.txt
register-pepper.txt
mcp-token-pepper.txt
register-session-key.txt
postgres-supervisor.txt
nats-supervisor.txt
