# BlueMap, public and read-only (decisions 0072 and 0071). Load this file, then `caddy reload`.
# Placeholders, never real values: GELDAR_DOMAIN (the project domain) and GELDAR_MAP_UPSTREAM
# (the BlueMap web address, set by the integration packet C2-07).
map.{$GELDAR_DOMAIN} {
	# GET and HEAD only; every other method is refused at Caddy.
	@not_allowed not method GET HEAD
	# A site-level respond sorts after handle, so the 405 is a handle that comes first.
	handle @not_allowed {
		respond 405
	}

	# Drop any address header a client sent. Caddy sets the one it vouches for inside reverse_proxy.
	request_header -x-geldar-client-ip
	request_header -X-Forwarded-For
	request_header -CF-Connecting-IP

	# BlueMap serves static files and the live player JSON (R38, C2-07m: bluemap-web proxies only /maps/*/live/* to Paper);
	# no request body is needed.
	request_body {
		max_size 1KiB
	}

	# Response headers that BlueMap needs no exception for. The full CSP is checked in C2-07 (0094).
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "frame-ancestors 'none'"
	}

	reverse_proxy {$GELDAR_MAP_UPSTREAM} {
		header_up x-geldar-client-ip {remote_host}
	}
}
