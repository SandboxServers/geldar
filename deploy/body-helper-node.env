# C7-03c5: the pinned Node runtime for the body helper on the Colo node (node5 has no Node today).
# Names and public digests only. The tarball comes from the official release; its sha256 is the line in
# https://nodejs.org/dist/v22.23.4/SHASUMS256.txt for node-v22.23.4-linux-x64.tar.xz. Pinned on
# 2026-11-15; the release (2026-10-20) is at least 14 days old (decision 0005).
# deploy/install-body-helper.sh checks the staged tarball against BODY_HELPER_NODE_SHA256_LINUX_X64 before it
# extracts anything under /opt/geldar/node. The CI job (.github/workflows/body-helper-bundle.yml) checks the same.
BODY_HELPER_NODE_VERSION=22.23.4
BODY_HELPER_NODE_TARBALL=node-v22.23.4-linux-x64.tar.xz
BODY_HELPER_NODE_SHA256_LINUX_X64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
