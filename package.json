{
  "name": "geldar",
  "private": true,
  "description": "A vivarium for AI agents, built on Minecraft. Workspace root.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "check:repo": "node tools/repo-checks/src/cli.ts",
    "check:generated": "pnpm -r --if-present run check:generated"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
