    "RegisterPayloadHandlersEvent",
    "ServerBossEvent",
    "ServerScoreboard",
    "performPrefixedCommand",
    "performCommand",
    "getCommands",
    "Commands.literal",
    "RegisterCommandsEvent",
    "setBlock",
    "setBlockAndUpdate",
    "destroyBlock",
    "addFreshEntity",
    "teleportTo",
    "setPos(",
    "kill(",
    "hurt(",
    "setGameMode",
    "disconnect(",
    "halt(",
    "setCanceled",
    "setCancelled",
    "setMessage",
    "setTickRate",
    "setFrozen",
    "ServerChatEvent",
    "getRawText",
    "getPlayerMessage",
    "ChatType",
    "SignText",
    "getFrontText",
    "getBackText",
    "SignBlockEntity",
    "WrittenBookContent",
    "WritableBookContent",
    "BookEditPacket",
    "getPages",
    "getRemoteAddress",
    "getHostAddress",
    "getAddress",
    "readString(",
    "readAllBytes(",
    "readAllLines(",
    "Files.lines(",
    "newBufferedReader(",
    "newInputStream(",
    "FileReader",
    "FileInputStream",
    "RandomAccessFile",
    "System.getenv(",
    "System.getProperties(",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "Authorization",
    "ProcessBuilder",
    "Runtime.getRuntime(",
    "Class.forName(",
    "setAccessible(",
    "HttpClient",
    "URLConnection"
  ],
  "allow": [
    {
      "file": "neoforge-ledger/src/main/java/dev/geldar/ledger/neoforge/LedgerMod.java",
      "name": "newInputStream(",
      "text": "Files.newInputStream(file)",
      "reason": "Reads the ledger own properties file (the agent config path), never chat, agent or repo content."
    },
    {
      "file": "neoforge-ledger/src/main/java/dev/geldar/ledger/neoforge/curated/CuratedWiring.java",
      "name": "ServerChatEvent",
      "text": "net.neoforged.neoforge.event.ServerChatEvent.class, e -> chat(text, e)",
      "reason": "PT-N8: the one chat listener (observation only: reads the text, never cancels or replies); owner-approved full-text capture D-F, cancelled messages skipped D-I."
    },
    {
      "file": "neoforge-ledger/src/main/java/dev/geldar/ledger/neoforge/curated/CuratedWiring.java",
      "name": "ServerChatEvent",
      "text": "private static void chat(TextContentFamily text, net.neoforged.neoforge.event.ServerChatEvent e)",
      "reason": "PT-N8: the parameter type of the same chat reader; no send, no setter."
    }
  ],
  "modsToml": {
    "path": "neoforge-ledger/src/main/resources/META-INF/neoforge.mods.toml",
    "forbiddenTables": ["mixins", "accessTransformers", "dependencies.ledger.mixin"],
    "forbiddenNameWords": ["telemetry", "trace", "otel", "metric", "monitor"]
  }
}
