# Copy to .env to override a default. Every key is optional; the values below are the defaults.
# `./geldar.ps1 adam up` reads this file (a variable in the real environment wins) and passes
# these keys to the three host processes. Every address must be loopback (decision 0050): `adam up`
# refuses anything else. Passwords are never set here; they are read from compose/secrets/*.txt.

# Which shards/<name>.yaml and compose/<name>.yml the run uses.
GELDAR_SHARD=phase0

# NATS (JetStream), read by the Mind and Adam's Body.
GELDAR_NATS_URL=nats://127.0.0.1:4222

# The Velocity bot ingress Adam's Body connects to.
GELDAR_MC_HOST=127.0.0.1
GELDAR_MC_PORT=25565

# Ollama, read by the Mind (the embedder check) and lantern-local, and by `adam models`.
OLLAMA_URL=http://127.0.0.1:11434

# The Mind's Thinker socket, where lantern-local connects. Defaults to mind.thinker in the shard file.
# GELDAR_MIND_WS_URL=ws://127.0.0.1:7410/v1/thinker/stream

# Postgres, read by the Mind. The password comes from compose/secrets/postgres.txt.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=geldar
POSTGRES_DB=geldar
# An absolute path to use another file than compose/secrets/postgres.txt:
# POSTGRES_PASSWORD_FILE=
# The Geldar MCP on loopback (./geldar.ps1 mcp up). Read by ./geldar.ps1 mcp smoke and the MCP live cases only.
# A loopback URL: the compose overlay publishes 127.0.0.1:8788 and nothing else.
GELDAR_MCP_URL=http://127.0.0.1:8788
# A path outside the repo to a player's token file (written by ./geldar.ps1 mcp-tokens token mint). Placeholder only.
# GELDAR_MCP_TEST_TOKEN_FILE=<path-outside-the-repo>/ag-test-01.token