{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geldar.dev/schemas/snapshot.schema.json",
  "title": "Snapshot",
  "description": "The perception snapshot the Body builds for every thought (spec Appendix A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "agent_id",
    "shard",
    "world_time",
    "self",
    "surroundings",
    "heard",
    "events_since_last_thought",
    "revision"
  ],
  "properties": {
    "snapshot_id": { "$ref": "common.schema.json#/$defs/SnapshotId" },
    "agent_id": { "$ref": "common.schema.json#/$defs/LifeId" },
    "shard": { "$ref": "common.schema.json#/$defs/ShardName" },
    "revision": {
      "description": "The snapshot revision the attention controller compares plans against (spec 5.3.2).",
      "type": "integer",
      "minimum": 0
    },
    "body_generation": {
      "description": "The Body's generation (restart counter) the snapshot was built in. Optional so older Bodies and the mock stay valid.",
      "type": "integer",
      "minimum": 0
    },
    "world_time": { "$ref": "#/$defs/SnapshotWorldTime" },
    "self": { "$ref": "#/$defs/SnapshotSelf" },
    "surroundings": { "$ref": "#/$defs/SnapshotSurroundings" },
    "heard": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "text", "age_seconds"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "maxLength": 32 },
          "text": { "type": "string", "maxLength": 256 },
          "age_seconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "events_since_last_thought": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "description": "Event payloads are typed in later packets, so this object only fixes its type name and allows other properties.",
        "type": "object",
        "additionalProperties": true,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z_]{0,47}$" }
        }
      }
    },
    "current_plan": { "$ref": "#/$defs/SnapshotPlan" },
    "stuck": { "$ref": "#/$defs/SnapshotStuck" }
  },
  "$defs": {
    "SnapshotWorldTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "time_of_day", "ticks", "weather"],
      "properties": {
        "day": { "type": "integer", "minimum": 0 },
        "time_of_day": { "type": "string", "enum": ["dawn", "day", "dusk", "night"] },
        "ticks": { "$ref": "common.schema.json#/$defs/WorldTick" },
        "weather": { "type": "string", "enum": ["clear", "rain", "thunder"] }
      }
    },
    "SnapshotSelf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "health",
        "hunger",
        "armor",
        "held_item",
        "inventory",
        "effects",
        "budget_remaining_thoughts",
        "days_since_sleep"
      ],
      "properties": {
        "position": { "$ref": "common.schema.json#/$defs/SelfPosition" },
        "health": { "type": "number", "minimum": 0, "maximum": 20 },
        "hunger": { "type": "integer", "minimum": 0, "maximum": 20 },
        "armor": { "type": "integer", "minimum": 0, "maximum": 20 },
        "held_item": {
          "description": "Null when the hand is empty.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/ItemName" }, { "type": "null" }]
        },
        "inventory": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ItemStack" }
        },
        "effects": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_]{1,64}$" }
        },
        "budget_remaining_thoughts": { "type": "integer", "minimum": 0 },
        "days_since_sleep": { "type": "integer", "minimum": 0 },
        "ground_below": {
          "description": "Blocks of air between the feet and solid ground below; 0 when grounded. Leaves do not count as ground. Capped at 32.",
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "trapped": {
          "description": "none on open ground; perched on leaves or over air; pit between walls at least 2 high with ground below.",
          "type": "string",
          "enum": ["none", "perched", "pit"]
        },
        "sun": {
          "description": "Coarse sun phase from the world time. Absent when there is no sky above (underground, indoors).",
          "type": "string",
          "enum": ["morning", "midday", "afternoon", "low", "set"]
        },
        "light": {
          "description": "Light at the head: bright from 12, dim from 4 to 11, dark below 4. Absent when unknown.",
          "type": "string",
          "enum": ["bright", "dim", "dark"]
        },
        "health_trend": {
          "description": "Health over a fixed sample window: rising, steady or falling.",
          "type": "string",
          "enum": ["rising", "steady", "falling"]
        },
        "regen_hint": {
          "description": "A fixed sentence stating the natural-regeneration rule, present only while hunger is below the regeneration threshold.",
          "type": "string",
          "maxLength": 256
        },
        "air": {
          "description": "Breath bubbles left, 0 to 20. Shown only below 20 (full breath omits the key).",
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "status_flags": {
          "description": "The true flags only, in a fixed order. Absent when none is true.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["burning", "underwater", "falling", "in_water", "on_ground"]
          }
        },
        "unlocked_recipes": {
          "description": "Item names the agent can craft because it has unlocked their recipes (spec 5.2, decision 0048). Optional: a Body without recipe knowledge omits it.",
          "type": "array",
          "maxItems": 1500,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ItemName" }
        }
      }
    },
    "SnapshotSurroundings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks_summary", "notable_blocks", "entities", "agents"],
      "properties": {
        "blocks_summary": { "type": "string" },
        "standing_on": {
          "type": "string",
          "pattern": "^[a-z_]{1,64}$",
          "description": "The block name under the feet (floor of y minus 1); air when there is none. Absent when the chunk is not loaded."
        },
        "block_above_feet": {
          "type": "string",
          "pattern": "^[a-z_]{1,64}$",
          "description": "The block name at the head (floor of y plus 1); air when there is none. Absent when the chunk is not loaded."
        },
        "enclosed": {
          "type": "boolean",
          "description": "True when solid blocks close the feet cell on every side, above and below (decision 0074). Absent when the Body does not report it."
        },
        "notable_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "x", "y", "z"],
            "properties": {
              "type": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
              "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
              "y": { "type": "integer", "minimum": -64, "maximum": 320 },
              "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
              "text": { "type": "string", "maxLength": 256 },
              "lit": {
                "description": "Furnaces only: true while the furnace is burning fuel.",
                "type": "boolean"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/SnapshotEntity" }
        },
        "hazards": {
          "description": "Lava, deep water, drops, fire and cactus within 8 blocks in line of sight, nearest first, at most 4.",
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/SnapshotHazard" }
        },
        "food_known": {
          "description": "Food sources the Body has seen (animals, crops, berries, dropped food), newest first, at most 10. An empty list means no food is known.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "x", "y", "z"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
              "y": { "type": "integer", "minimum": -64, "maximum": 320 },
              "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 }
            }
          }
        },
        "blocks_counted_in_sight": {
          "description": "True when block counts only include cells the Body can see (line of sight).",
          "type": "boolean"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "distance", "held_item", "health_estimate"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 32 },
              "distance": { "type": "number", "minimum": 0 },
              "held_item": {
                "anyOf": [{ "$ref": "common.schema.json#/$defs/ItemName" }, { "type": "null" }]
              },
              "health_estimate": { "type": "string", "maxLength": 32 }
            }
          }
        }
      }
    },
    "SnapshotEntity": {
      "description": "A being in sight. The MCP entities copy in mcp-common.schema.json refers to this definition, so the two cannot drift.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "distance", "direction", "x", "y", "z"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
        "distance": { "type": "number", "minimum": 0 },
        "direction": { "type": "string", "pattern": "^[a-z_]{1,16}$" },
        "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "item": { "$ref": "common.schema.json#/$defs/ItemName" },
        "count": { "type": "integer", "minimum": 1 },
        "hostile": {
          "description": "True for a mob that is always hostile by its type. Conditional and neutral mobs are not flagged from type alone.",
          "type": "boolean"
        },
        "state": {
          "description": "Observed state of a mob: idle, closing (distance fell over the last samples), attacking or fleeing.",
          "type": "string",
          "enum": ["idle", "closing", "attacking", "fleeing"]
        },
        "closing": {
          "description": "True when the distance to the Body fell over the last two samples.",
          "type": "boolean"
        },
        "held_item": { "$ref": "common.schema.json#/$defs/ItemName" },
        "fuse": {
          "description": "A creeper that is ignited shows hissing.",
          "type": "string",
          "enum": ["hissing"]
        }
      }
    },
    "SnapshotHazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dir", "dist"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["lava", "deep_water", "drop", "fire", "cactus"]
        },
        "dir": { "$ref": "common.schema.json#/$defs/CompassPoint" },
        "dist": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "SnapshotPlan": {
      "description": "Null when the agent has no plan.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "action", "status"],
          "properties": {
            "goal": { "type": "string", "maxLength": 256 },
            "action": { "type": "string", "maxLength": 256 },
            "status": { "type": "string", "maxLength": 64 }
          }
        },
        { "type": "null" }
      ]
    },
    "SnapshotStuck": {
      "description": "Null unless the Body reports a repeating action, with the repeat count.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "repeat_count"],
          "properties": {
            "action": { "type": "string", "maxLength": 256 },
            "repeat_count": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
