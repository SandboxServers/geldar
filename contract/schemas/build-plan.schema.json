{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geldar.dev/schemas/build-plan.schema.json",
  "title": "BuildPlan",
  "description": "A building plan: a palette of block states and an ordered list of steps that expand to block cells. Steps are absolute, or relative to origin when origin is given. Used by the plan action (action-plan.schema.json) and the plan_check tool. There is no maximum on cell counts; chunked upload (final and seq) keeps each thought small. The world border and the height limits of absolute cells are checked by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["palette", "steps"],
  "properties": {
    "palette": { "$ref": "#/$defs/BuildPalette" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "The steps, in the order given. Each expands to cells.",
      "items": { "$ref": "#/$defs/BuildStep" }
    },
    "origin": { "$ref": "#/$defs/BuildOrigin" },
    "order": { "$ref": "#/$defs/BuildOrder" },
    "final": {
      "type": "boolean",
      "default": true,
      "description": "False when more chunks of this plan follow. A chunk with final false needs seq."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "The order of this chunk within its plan, counting from 0."
    }
  },
  "anyOf": [
    {
      "not": {
        "type": "object",
        "required": ["final"],
        "properties": { "final": { "const": false } }
      }
    },
    { "type": "object", "required": ["seq"], "properties": { "seq": {} } }
  ],
  "$defs": {
    "BuildPlanId": {
      "type": "string",
      "description": "The name of a plan, unique for the life.",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "BuildPaletteKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,15}$"
    },
    "BuildPalette": {
      "type": "object",
      "description": "Named block states that the steps refer to by name.",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/BuildPaletteKey" },
      "additionalProperties": { "$ref": "#/$defs/BuildPaletteEntry" }
    },
    "BuildPaletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block"],
      "properties": {
        "block": { "$ref": "common.schema.json#/$defs/ItemName" },
        "state": {
          "type": "object",
          "description": "Block properties, such as facing or axis, as name and value strings.",
          "maxProperties": 8,
          "additionalProperties": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" }
        }
      }
    },
    "BuildCoord": {
      "type": "object",
      "description": "A block cell. Absolute when the plan has no origin; otherwise an offset from origin.",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "$ref": "block-owner.schema.json#/$defs/BlockCoordinateXZ" },
        "y": { "$ref": "block-owner.schema.json#/$defs/BlockCoordinateY" },
        "z": { "$ref": "block-owner.schema.json#/$defs/BlockCoordinateXZ" }
      }
    },
    "BuildBlockCell": {
      "type": "object",
      "description": "An absolute block cell. The height is the world height.",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "$ref": "block-owner.schema.json#/$defs/BlockCoordinateXZ" },
        "y": { "type": "integer", "minimum": -64, "maximum": 320 },
        "z": { "$ref": "block-owner.schema.json#/$defs/BlockCoordinateXZ" }
      }
    },
    "BuildOrigin": {
      "description": "The cell that relative steps are measured from. Resolved once, when the plan is added. The word here means the cell under the agent's feet.",
      "anyOf": [{ "$ref": "#/$defs/BuildCoord" }, { "const": "here" }]
    },
    "BuildOrder": {
      "type": "string",
      "enum": ["bottom_up", "given"],
      "default": "bottom_up",
      "description": "bottom_up places from the lowest layer outward; given keeps the step order."
    },
    "BuildCellFailureCode": {
      "type": "string",
      "enum": [
        "done_already",
        "changed",
        "blocked",
        "no_reference",
        "out_of_reach",
        "not_loaded",
        "missing_materials",
        "no_tool",
        "unbreakable",
        "state_unachievable",
        "timeout",
        "refused"
      ]
    },
    "BuildPalOrBreak": {
      "description": "A geometry step places the block named by pal, unless it is a break step.",
      "anyOf": [
        { "type": "object", "required": ["pal"], "properties": { "pal": {} } },
        { "type": "object", "required": ["break"], "properties": { "break": { "const": true } } }
      ]
    },
    "BuildStep": {
      "description": "One step. The op field selects the step kind; the others are not allowed.",
      "oneOf": [
        { "$ref": "#/$defs/BuildPlaceStep" },
        { "$ref": "#/$defs/BuildBreakStep" },
        { "$ref": "#/$defs/BuildReplaceStep" },
        { "$ref": "#/$defs/BuildBoxStep" },
        { "$ref": "#/$defs/BuildLineStep" },
        { "$ref": "#/$defs/BuildWallStep" },
        { "$ref": "#/$defs/BuildCircleStep" },
        { "$ref": "#/$defs/BuildSphereStep" },
        { "$ref": "#/$defs/BuildListStep" }
      ]
    },
    "BuildPlaceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "pal", "at"],
      "properties": {
        "op": { "const": "place" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "at": { "$ref": "#/$defs/BuildCoord" }
      }
    },
    "BuildBreakStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "at"],
      "properties": {
        "op": { "const": "break" },
        "at": { "$ref": "#/$defs/BuildCoord" }
      }
    },
    "BuildReplaceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "pal", "at"],
      "properties": {
        "op": { "const": "replace" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "at": { "$ref": "#/$defs/BuildCoord" }
      }
    },
    "BuildBoxStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to"],
      "properties": {
        "op": { "enum": ["box", "hollow_box"] },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "from": { "$ref": "#/$defs/BuildCoord" },
        "to": { "$ref": "#/$defs/BuildCoord" },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    },
    "BuildLineStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to"],
      "properties": {
        "op": { "const": "line" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "from": { "$ref": "#/$defs/BuildCoord" },
        "to": { "$ref": "#/$defs/BuildCoord" },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    },
    "BuildWallStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to", "height"],
      "properties": {
        "op": { "const": "wall" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "from": { "$ref": "#/$defs/BuildCoord" },
        "to": { "$ref": "#/$defs/BuildCoord" },
        "height": { "type": "integer", "minimum": 1 },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    },
    "BuildCircleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "center", "radius", "axis"],
      "properties": {
        "op": { "const": "circle" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "center": { "$ref": "#/$defs/BuildCoord" },
        "radius": { "type": "integer", "minimum": 1 },
        "axis": { "enum": ["x", "y", "z"] },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    },
    "BuildSphereStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "center", "radius"],
      "properties": {
        "op": { "const": "sphere" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "center": { "$ref": "#/$defs/BuildCoord" },
        "radius": { "type": "integer", "minimum": 1 },
        "hollow": { "type": "boolean", "default": false },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    },
    "BuildListStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "cells"],
      "properties": {
        "op": { "const": "list" },
        "pal": { "$ref": "#/$defs/BuildPaletteKey" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/BuildCoord" }
        },
        "break": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/BuildPalOrBreak" }]
    }
  }
}
