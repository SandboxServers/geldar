{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geldar.dev/schemas/action-plan.schema.json",
  "title": "PlanAction",
  "description": "The plan action: add or replace a building plan, sent in chunks with final and seq when it is large, or cancel one plan or all of them. The body works the plan between thoughts and pauses it for reflexes and foreground intents.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "op", "plan_id", "palette", "steps"],
      "properties": {
        "do": { "const": "plan" },
        "op": {
          "description": "add starts a plan; replace drops the unexecuted cells of the plan with this plan_id and keeps the placed ones.",
          "enum": ["add", "replace"]
        },
        "plan_id": { "$ref": "build-plan.schema.json#/$defs/BuildPlanId" },
        "palette": { "$ref": "build-plan.schema.json#/$defs/BuildPalette" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "build-plan.schema.json#/$defs/BuildStep" }
        },
        "origin": { "$ref": "build-plan.schema.json#/$defs/BuildOrigin" },
        "order": { "$ref": "build-plan.schema.json#/$defs/BuildOrder" },
        "final": { "type": "boolean", "default": true },
        "seq": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        {
          "not": {
            "type": "object",
            "required": ["final"],
            "properties": { "final": { "const": false } }
          }
        },
        { "type": "object", "required": ["seq"], "properties": { "seq": {} } }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "op", "plan_id"],
      "properties": {
        "do": { "const": "plan" },
        "op": { "const": "cancel" },
        "plan_id": {
          "description": "The plan to cancel, or all to cancel every plan of this life.",
          "anyOf": [{ "$ref": "build-plan.schema.json#/$defs/BuildPlanId" }, { "const": "all" }]
        }
      }
    }
  ]
}
