# syntax=docker/dockerfile:1
# The Mind for Adam-class agents on the colo Record/Mind host: animus/src/main.ts (decisions 0078, 0083).
# Build from the repo root:  docker build -f animus/Dockerfile.mind -t geldar-mind:c1 .
# The Node digest is the one golem/Dockerfile pins (pushed 2026-09-19, past the 14-day floor).
# The model endpoint (Thinker gateway) and the Postgres password file are run-time configuration, never baked in.
FROM node:22.23.2-trixie-slim@sha256:c5849ff9c9ebcd66615412f0b548ca5b8ecaef84003dc9ac2e077ebe46aaa3f6 AS deps
RUN corepack enable
WORKDIR /opt/geldar
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY contract ./contract
COPY animus ./animus
RUN pnpm install --frozen-lockfile --prod --filter "@geldar/animus..."

FROM node:22.23.2-trixie-slim@sha256:c5849ff9c9ebcd66615412f0b548ca5b8ecaef84003dc9ac2e077ebe46aaa3f6 AS mind
LABEL org.opencontainers.image.source="https://github.com/SandboxServers/geldar"
COPY --from=deps /opt/geldar /opt/geldar
ENV NODE_ENV=production
# Nothing secret is set here. Postgres and NATS credentials arrive as *_FILE paths at run time. Nothing is written.
# The shard file is read from /opt/geldar/shards, mounted at run time. The image has no listening port.
USER 1000:1000
WORKDIR /opt/geldar/animus
ENTRYPOINT ["node", "src/main.ts"]
