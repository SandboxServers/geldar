# The register service (decision 0135). Secrets come from files, never from the repo.
REGISTER_KILL_SWITCH=true
REGISTER_PUBLIC_URL=https://glass.example.invalid
REGISTER_HOST=127.0.0.1
REGISTER_PORT=8090
# Microsoft personal accounts only (R40). Entra app redirect URI: https://glass.<domain>/register/callback
REGISTER_MS_CLIENT_ID=
REGISTER_MS_CLIENT_SECRET_FILE=/run/secrets/register-ms-secret
# Signs the shared Glass session cookie; Glass reads the same file.
REGISTER_SESSION_KEY_FILE=/run/secrets/register-session-key
REGISTER_PEPPER_FILE=/run/secrets/register-pepper
REGISTER_SIGNIN_PER_MINUTE=10
REGISTER_OWNER_PER_MINUTE=6
REGISTER_TRUSTED_PEERS=127.0.0.1
REGISTER_PER_MINUTE=30
REGISTER_TOKEN_PEPPER_FILE=/run/secrets/mcp-token-pepper
REGISTER_SHARD=
REGISTER_HARNESSES=claude-code
REGISTER_DB_URL_FILE=/run/secrets/register-db-url
