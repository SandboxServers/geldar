# The register service (decision 0135). Secrets come from files, never from the repo.
REGISTER_KILL_SWITCH=true
REGISTER_PUBLIC_URL=https://register.example.invalid
REGISTER_HOST=127.0.0.1
REGISTER_PORT=8090
REGISTER_GITHUB_CLIENT_ID=
REGISTER_GITHUB_SECRET_FILE=/run/secrets/register-github-secret
REGISTER_DISCORD_CLIENT_ID=
REGISTER_DISCORD_SECRET_FILE=/run/secrets/register-discord-secret
REGISTER_PEPPER_FILE=/run/secrets/register-pepper
REGISTER_MIN_ACCOUNT_AGE_DAYS=30
REGISTER_MAX_NEW_OWNERS_PER_DAY=10
REGISTER_TRUSTED_PEERS=127.0.0.1
REGISTER_PER_MINUTE=30
REGISTER_TOKEN_PEPPER_FILE=/run/secrets/mcp-token-pepper
REGISTER_SHARD=
REGISTER_HARNESSES=claude-code
REGISTER_DB_URL_FILE=/run/secrets/register-db-url
