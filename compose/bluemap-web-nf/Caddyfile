# The NeoForge BlueMap map server (NF-BM-3, design note docs/analysis/bluemap/neoforge-map-design.md). Static files only,
# read from the read-only webroot at /srv: the bluemap/web subpath of the neoforge-data volume (README.md in this folder).
# No live player files (players are hidden in BlueMap's config and this server returns 404 for them), no reverse proxy, no
# custom scripts or styles. GET and HEAD only. Same tile and gzip handling as compose/bluemap-web/Caddyfile.
{
	admin off
	auto_https off
}

:8110 {
	header {
		X-Content-Type-Options nosniff
		-Server
	}

	@not_allowed not method GET HEAD
	handle @not_allowed {
		respond 405
	}

	# Never served on this map, whether or not the file exists in the webroot: any path with a segment named live or
	# players.json (any case), any empty segment (//) and any .. segment, after decoding. The cleaned path
	# ({http.request.uri.path}) and the original path ({http.request.orig_uri.path}) are both tested, so neither the
	# path cleaning nor an encoded slash can hide a segment. The 404 is answered here, before file_server, and there is
	# no proxy behind it.
	@blocked expression "{http.request.uri.path}.matches('(?i)(^|/)(live|players[.]json)(/|$)') || {http.request.orig_uri.path}.matches('(?i)(^|/)(live|players[.]json)(/|$)') || {http.request.uri.path}.matches('(^|/)[.][.](/|$)') || {http.request.orig_uri.path}.matches('(^|/)[.][.](/|$)') || {http.request.uri.path}.contains('//') || {http.request.orig_uri.path}.contains('//')"
	handle @blocked {
		respond 404
	}

	# BlueMap's file storage writes only textures.json.gz and tiles as *.prbm.gz (low-res tiles may be plain .png).
	# The browser asks for the plain name, so serve the .gz under it with Content-Encoding: gzip, unconditionally, as
	# BlueMap's nginx and apache examples do. (Caddy's `precompressed` needs the plain file to exist, so it cannot do it.)
	@gz path_regexp gz ^(/maps/[A-Za-z0-9_-]+/(textures\.json|tiles/.+\.prbm))$
	handle @gz {
		root * /srv
		rewrite * {re.gz.1}.gz
		header Content-Encoding gzip
		@json path /maps/*/textures.json
		header @json Content-Type application/json
		@bin path_regexp \.prbm$
		header @bin Content-Type application/octet-stream
		route {
			file_server {
				pass_thru
			}
			# A tile BlueMap has not rendered is 204 (BlueMap's docs), not 404.
			respond 204
		}
	}

	@tiles path /maps/*/tiles/*
	handle @tiles {
		root * /srv
		route {
			file_server {
				pass_thru
			}
			respond 204
		}
	}

	handle {
		root * /srv
		file_server
	}
}
