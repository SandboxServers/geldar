# The BlueMap map server (C2-07m, ruling R38, decisions 0072, 0094). Static tiles come from the read-only webroot at /srv.
# Only the live player JSON (/maps/<map>/live/<file>) is proxied to BlueMap's integrated web server inside Paper, on the
# colo network (paper:8101, not published to the host). No other path reaches Paper. GET and HEAD only.
{
	admin off
	auto_https off
}

:8100 {
	@not_allowed not method GET HEAD
	handle @not_allowed {
		respond 405
	}

	# The live files are .json (players.json, markers.json). The map name and file name are plain tokens: no dot-only
	# segment and no slash, so the proxy cannot be steered to another Paper path.
	@live path_regexp live ^/maps/[A-Za-z0-9_-]+/live/[A-Za-z0-9_-]+(\.json)?$
	handle @live {
		reverse_proxy paper:8101 {
			header_up -x-geldar-client-ip
		}
	}

	# BlueMap's file storage writes only textures.json.gz and tiles as *.prbm.gz (low-res tiles may be plain .png).
	# The browser asks for the plain name, so serve the .gz under it with Content-Encoding: gzip, unconditionally, as
	# BlueMap's nginx and apache examples do. (Caddy's `precompressed` needs the plain file to exist, so it cannot do it.)
	@gz path_regexp gz ^(/maps/[A-Za-z0-9_-]+/(textures\.json|tiles/.+\.prbm))$
	handle @gz {
		root * /srv
		rewrite * {re.gz.1}.gz
		header Content-Encoding gzip
		@json path /maps/*/textures.json
		header @json Content-Type application/json
		@bin path_regexp \.prbm$
		header @bin Content-Type application/octet-stream
		route {
			file_server {
				pass_thru
			}
			# A tile BlueMap has not rendered is 204 (BlueMap's docs), not 404.
			respond 204
		}
	}

	@tiles path /maps/*/tiles/*
	handle @tiles {
		root * /srv
		route {
			file_server {
				pass_thru
			}
			respond 204
		}
	}

	handle {
		root * /srv
		file_server
	}
}
