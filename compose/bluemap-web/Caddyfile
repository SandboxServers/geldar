# The BlueMap map server (C2-07m, ruling R38, decisions 0072, 0094). Static tiles come from the read-only webroot at /srv.
# Only the live player JSON (/maps/<map>/live/<file>) is proxied to BlueMap's integrated web server inside Paper, on the
# colo network (paper:8101, not published to the host) through the bluemap-alias proxy (private aliases for names). GET and HEAD only.
{
	admin off
	auto_https off
}

:8100 {
	@not_allowed not method GET HEAD
	handle @not_allowed {
		respond 405
	}

	# The live files are .json (players.json, markers.json). The map name and file name are plain tokens: no dot-only
	# segment and no slash, so the proxy cannot be steered to another Paper path.
	@live path_regexp live ^/maps/[A-Za-z0-9_-]+/live/[A-Za-z0-9_-]+(\.json)?$
	# Never straight to Paper: players.json carries agent usernames, so it goes through the alias proxy
	# (plugins/bluemap/alias-proxy), which replaces every name with a private alias or a neutral label.
	handle @live {
		reverse_proxy bluemap-alias:8102 {
			header_up -x-geldar-client-ip
		}
	}

	# The Geldar stylesheet (fixed square player heads), listed in the webroot's settings.json "styles".
	handle /assets/geldar.css {
		root * /etc/caddy
		rewrite * /geldar.css
		file_server
	}

	# The chat panel script (decision 0310), listed in the webroot's settings.json "scripts". Same-origin only.
	handle /assets/geldar-chat.js {
		root * /etc/caddy
		rewrite * /geldar-chat.js
		header Content-Type "text/javascript; charset=utf-8"
		file_server
	}

	# The time-of-day dial script (BM-15), listed in the same "scripts" array. Same-origin only.
	handle /assets/geldar-sky.js {
		root * /etc/caddy
		rewrite * /geldar-sky.js
		header Content-Type "text/javascript; charset=utf-8"
		file_server
	}

	# BlueMap's settings.json, pinned in the repo (BM-16). BlueMap rewrites the webroot copy on every start and drops the
	# scripts and styles, so this file is served instead. Same-origin only.
	handle /settings.json {
		root * /etc/caddy
		rewrite * /geldar-settings.json
		header Content-Type "application/json"
		header Cache-Control no-cache
		file_server
	}

	# The chat feed the plugin writes into the webroot (decision 0310). It changes every few seconds: never cached.
	@chat path /geldar-chat.json
	handle @chat {
		header Cache-Control no-store
		root * /srv
		file_server
	}

	# BlueMap's file storage writes only textures.json.gz and tiles as *.prbm.gz (low-res tiles may be plain .png).
	# The browser asks for the plain name, so serve the .gz under it with Content-Encoding: gzip, unconditionally, as
	# BlueMap's nginx and apache examples do. (Caddy's `precompressed` needs the plain file to exist, so it cannot do it.)
	@gz path_regexp gz ^(/maps/[A-Za-z0-9_-]+/(textures\.json|tiles/.+\.prbm))$
	handle @gz {
		root * /srv
		rewrite * {re.gz.1}.gz
		header Content-Encoding gzip
		@json path /maps/*/textures.json
		header @json Content-Type application/json
		@bin path_regexp \.prbm$
		header @bin Content-Type application/octet-stream
		route {
			file_server {
				pass_thru
			}
			# A tile BlueMap has not rendered is 204 (BlueMap's docs), not 404.
			respond 204
		}
	}

	@tiles path /maps/*/tiles/*
	handle @tiles {
		root * /srv
		route {
			file_server {
				pass_thru
			}
			respond 204
		}
	}

	handle {
		root * /srv
		file_server
	}
}
