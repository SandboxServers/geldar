# Allowlist: nothing enters the build context unless named here.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.nvmrc
!**/package.json
# Glass imports no other workspace package (web/ imports from contract are type-only and stripped), so only its own tree is needed.
!glass/src
!glass/public
# The Kino static app (wiring.ts reads glass/web/kino at start when GELDAR_KINO_ENABLED=1).
!glass/web
# The re-include above also matches every installed package.json; drop installed trees.
**/node_modules/**
**/node_modules
**/*.test.ts
glass/test
glass/src/render-fixtures.ts
**/.env*
**/*tokens*.json
**/secrets
